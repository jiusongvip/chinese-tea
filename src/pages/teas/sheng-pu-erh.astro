---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import TeaCard from '../../components/TeaCard.astro';
import CTACard from '../../components/CTACard.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { getTea, getRelatedTeas, stars } from '../../data/teas';
import { getTeaType } from '../../data/teaTypes';
import { teaItemSchema, qaSchema, faqSchema } from '../../data/schemas';
import { SITE } from '../../data/siteMeta';
import FaIcon from '../../components/FaIcon.astro';
import { faLocationDot, faCircleCheck, faTriangleExclamation } from '@fortawesome/free-solid-svg-icons';

const tea = getTea('pu-erh-sheng');
if (!tea) return new Response(null, { status: 404, statusText: 'Not found' });

const type = getTeaType(tea.type);
const related = getRelatedTeas(tea.slug);

const title = 'Sheng Pu-erh Tea: Complete Guide to Raw Pu-erh';
const description = 'Sheng pu-erh (raw pu-erh) is the traditional, naturally aged form of pu-erh tea from Yunnan, China. Learn its flavor profile, health benefits, brewing techniques, and how it differs from shou pu-erh.';

const shengVsShouFaq = {
  q: "What is the difference between sheng pu-erh and shou pu-erh?",
  a: "Sheng pu-erh (raw pu-erh) is the traditional form — sun-dried green tea from Yunnan's large-leaf trees that is pressed and aged naturally over years or decades. It develops complex, sometimes fruity and camphor-like flavors through slow oxidation. Shou pu-erh (ripe pu-erh) was invented in 1973 to accelerate aging through a wet-piling (wo dui) fermentation process that takes 45-60 days. The result is a darker, earthier, smoother tea that mimics decades of aging. Sheng tends to be more astringent and complex when young, while shou is mellow and earthy from the start. Both are excellent — the choice depends on whether you prefer aging potential (sheng) or immediate drinkability (shou)."
};

const teaQa = [
  { q: `How do you brew sheng pu-erh?`, a: `Brew sheng pu-erh at ${tea.brewing.temp}. For gongfu style, steep ${tea.brewing.timeGongfu}; Western style, ${tea.brewing.timeWestern}. Use ${tea.brewing.vessel} with ${tea.brewing.ratio}. Expect ${tea.brewing.infusions} infusions.` },
  { q: `Where is sheng pu-erh from?`, a: `${tea.name} is produced in ${tea.origin}. ${tea.harvest}` },
  shengVsShouFaq,
];

const schemaJson = JSON.stringify([
  teaItemSchema(tea),
  ...qaSchema(teaQa, { url: new URL('/teas/sheng-pu-erh/', SITE.url).href, datePublished: '2026-08-01', dateModified: '2026-09-05' }),
  faqSchema(teaQa),
]);
---

<BaseLayout {title} {description} schemaJson={schemaJson} ogImage={tea.image}>

  <!-- Hero -->
  <section class="relative bg-leaf-950 text-white overflow-hidden">
    <div class="absolute inset-0 opacity-30">
      <img src={tea.image} alt="Sheng Pu-erh Tea" class="w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="async" width="1200" height="800" />
      <div class="absolute inset-0 bg-gradient-to-b from-leaf-950/70 via-leaf-950/85 to-leaf-950"></div>
    </div>
    <div class="relative z-10 section-container py-16 md:py-20">
      <div class="flex flex-wrap items-center gap-3 mb-5">
        <a href={`/types/${type?.slug}/`} class={`px-3 py-1 text-xs font-bold rounded-full ${type?.accent?.badge ?? 'bg-white/20 text-white'}`}>{type?.name}</a>
        <a href="/teas/" class="text-xs text-leaf-200/70 hover:text-white transition-colors">← All famous teas</a>
      </div>
      <h1 class="text-4xl md:text-5xl font-display font-bold tracking-tight max-w-3xl">Sheng Pu-erh Tea <span class="text-leaf-300 text-2xl md:text-3xl font-semibold">{tea.nameChinese}</span></h1>
      <p class="mt-4 text-lg text-leaf-100/85 max-w-2xl">Sheng pu-erh, also known as raw pu-erh, is the traditional, naturally aged form of pu-erh tea from Yunnan, China. Unlike shou pu-erh, which is artificially fermented to accelerate aging, sheng pu-erh develops its complex, earthy, and sometimes fruity flavors over many years of natural maturation. This guide covers everything from its flavor profile and health benefits to proper brewing techniques.</p>
      <div class="mt-8 flex flex-wrap gap-3 text-xs">
        <span class="px-3 py-1.5 rounded-lg bg-white/10 border border-white/10 inline-flex items-center gap-1.5"><span class="text-leaf-300"><FaIcon icon={faLocationDot} size={12} /></span> {tea.origin}</span>
        <span class="px-3 py-1.5 rounded-lg bg-white/10 border border-white/10">Caffeine: {tea.caffeine}</span>
        <span class="px-3 py-1.5 rounded-lg bg-white/10 border border-white/10">Beginner: {stars(tea.beginner)}</span>
      </div>
    </div>
  </section>

  <!-- Quick facts strip -->
  <section class="section-container -mt-8 relative z-20 reveal">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      <div class="card p-4"><p class="text-xs uppercase tracking-wider text-zinc-500 mb-1">Water Temp</p><p class="font-semibold text-warm-900">{tea.brewing.temp}</p></div>
      <div class="card p-4"><p class="text-xs uppercase tracking-wider text-zinc-500 mb-1">Infusions</p><p class="font-semibold text-warm-900">{tea.brewing.infusions}</p></div>
      <div class="card p-4"><p class="text-xs uppercase tracking-wider text-zinc-500 mb-1">Harvest</p><p class="font-semibold text-warm-900 text-sm leading-snug">{tea.harvest}</p></div>
      <div class="card p-4"><p class="text-xs uppercase tracking-wider text-zinc-500 mb-1">Entry Price</p><p class="font-semibold text-warm-900 text-sm leading-snug">{tea.buying.priceEntry}</p></div>
    </div>
  </section>

  <!-- What is Sheng Pu-erh? -->
  <section class="section-container py-16">
    <div class="max-w-3xl mx-auto reveal">
      <SectionHeader eyebrow="Understanding" title="What Is Sheng Pu-erh?" headingLevel="h2" />
      <div class="mt-6 space-y-4 text-warm-700 leading-relaxed">
        <p>Sheng pu-erh (生普洱), also called raw pu-erh, is the original and traditional form of pu-erh tea. Made from the large-leaf tea trees (<em>Camellia sinensis var. assamica</em>) of Yunnan Province, sheng pu-erh is sun-dried after picking, then compressed into cakes, bricks, or tuo shapes. Unlike shou pu-erh, which undergoes accelerated fermentation through wet-piling (wo dui), sheng pu-erh ages naturally through slow oxidation over years or even decades.</p>
        <p>When young, sheng pu-erh is bright, astringent, and sometimes bitter with floral and vegetal notes. As it ages, it transforms dramatically — the liquor darkens from pale gold to deep amber, and the flavor develops into something smooth, complex, and deeply satisfying, with notes of dried fruit, camphor, wood, and medicine. This aging potential is what makes sheng pu-erh a favorite among collectors and connoisseurs.</p>
        <p>Think of sheng pu-erh like fine wine: young sheng is bold and tannic, while aged sheng is smooth and layered. The best sheng pu-erhs from famous mountains like Lao Ban Zhang, Bing Dao, and Yi Wu can age for 20-50+ years, becoming increasingly valuable and complex over time.</p>
      </div>
    </div>
  </section>

  <!-- Sheng vs Shou Comparison -->
  <section class="bg-paper-100 py-16">
    <div class="section-container">
      <SectionHeader eyebrow="Comparison" title="Sheng Pu-erh vs Shou Pu-erh" subtitle="The two types of pu-erh tea explained — and how to choose between them." headingLevel="h2" />
      <div class="mt-8 overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="border-b-2 border-paper-300">
              <th class="text-left py-3 px-4 font-semibold text-warm-900 w-1/4">Feature</th>
              <th class="text-left py-3 px-4 font-semibold text-leaf-800 w-[37.5%]">Sheng Pu-erh (Raw)</th>
              <th class="text-left py-3 px-4 font-semibold text-amber-800 w-[37.5%]">Shou Pu-erh (Ripe)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-paper-200">
            <tr>
              <td class="py-3 px-4 text-zinc-600 font-medium">Chinese Name</td>
              <td class="py-3 px-4 text-warm-800">生普洱 (Shēng Pǔ'ěr)</td>
              <td class="py-3 px-4 text-warm-800">熟普洱 (Shú Pǔ'ěr)</td>
            </tr>
            <tr>
              <td class="py-3 px-4 text-zinc-600 font-medium">Processing</td>
              <td class="py-3 px-4 text-warm-800">Sun-dried, pressed, naturally aged</td>
              <td class="py-3 px-4 text-warm-800">Wet-piled (wo dui) fermentation, 45-60 days</td>
            </tr>
            <tr>
              <td class="py-3 px-4 text-zinc-600 font-medium">Invented</td>
              <td class="py-3 px-4 text-warm-800">Ancient (centuries old)</td>
              <td class="py-3 px-4 text-warm-800">1973 (modern invention)</td>
            </tr>
            <tr>
              <td class="py-3 px-4 text-zinc-600 font-medium">Color (Liquor)</td>
              <td class="py-3 px-4 text-warm-800">Pale gold (young) → deep amber (aged)</td>
              <td class="py-3 px-4 text-warm-800">Dark mahogany, opaque</td>
            </tr>
            <tr>
              <td class="py-3 px-4 text-zinc-600 font-medium">Young Flavor</td>
              <td class="py-3 px-4 text-warm-800">Bright, astringent, bitter-sweet, floral</td>
              <td class="py-3 px-4 text-warm-800">Smooth, earthy, woody, zero astringency</td>
            </tr>
            <tr>
              <td class="py-3 px-4 text-zinc-600 font-medium">Aged Flavor</td>
              <td class="py-3 px-4 text-warm-800">Complex, camphor, dried fruit, medicine</td>
              <td class="py-3 px-4 text-warm-800">Deeper earth, aged wood, sweet finish</td>
            </tr>
            <tr>
              <td class="py-3 px-4 text-zinc-600 font-medium">Aging Potential</td>
              <td class="py-3 px-4 text-warm-800">20-50+ years, transforms dramatically</td>
              <td class="py-3 px-4 text-warm-800">Improves but less dramatic change</td>
            </tr>
            <tr>
              <td class="py-3 px-4 text-zinc-600 font-medium">Caffeine</td>
              <td class="py-3 px-4 text-warm-800">High</td>
              <td class="py-3 px-4 text-warm-800">Medium</td>
            </tr>
            <tr>
              <td class="py-3 px-4 text-zinc-600 font-medium">Beginner Friendly</td>
              <td class="py-3 px-4 text-warm-800">★★★☆☆ (acquired taste when young)</td>
              <td class="py-3 px-4 text-warm-800">★★★★☆ (smooth from the start)</td>
            </tr>
            <tr>
              <td class="py-3 px-4 text-zinc-600 font-medium">Price Range</td>
              <td class="py-3 px-4 text-warm-800">$15-500+ / cake</td>
              <td class="py-3 px-4 text-warm-800">$10-150+ / cake</td>
            </tr>
            <tr>
              <td class="py-3 px-4 text-zinc-600 font-medium">Best For</td>
              <td class="py-3 px-4 text-warm-800">Collectors, aging, connoisseurs</td>
              <td class="py-3 px-4 text-warm-800">Daily drinking, beginners, digestion</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mt-6 text-sm text-muted">New to pu-erh? <a href="/teas/pu-erh-shou/" class="text-accent underline hover:text-accent-dark">Start with shou pu-erh</a> for a smoother introduction, or explore <a href="/teas/pu-erh-sheng/" class="text-accent underline hover:text-accent-dark">sheng pu-erh</a> if you enjoy the idea of aging tea like fine wine.</p>
    </div>
  </section>

  <!-- Flavor + brewing -->
  <section class="section-container py-16">
    <div class="grid lg:grid-cols-2 gap-10">
      <div class="reveal">
        <SectionHeader eyebrow="Flavor Profile" title="Taste & Aroma" headingLevel="h2" />
        <div class="mt-6 space-y-4 text-sm">
          <div class="card p-4 flex gap-3"><span class="text-zinc-500 w-16 flex-shrink-0 font-medium">Aroma</span><span class="text-warm-700">{tea.flavor.aroma}</span></div>
          <div class="card p-4 flex gap-3"><span class="text-zinc-500 w-16 flex-shrink-0 font-medium">Taste</span><span class="text-warm-700">{tea.flavor.taste}</span></div>
          <div class="card p-4 flex gap-3"><span class="text-zinc-500 w-16 flex-shrink-0 font-medium">Color</span><span class="text-warm-700">{tea.flavor.color}</span></div>
          <div class="card p-4 flex gap-3"><span class="text-zinc-500 w-16 flex-shrink-0 font-medium">Body</span><span class="text-warm-700">{tea.flavor.body}</span></div>
        </div>
      </div>
      <div class="reveal">
        <SectionHeader eyebrow="Brewing Guide" title="How to Brew It" headingLevel="h2" />
        <div class="mt-6 grid grid-cols-2 gap-3 text-sm">
          <div class="card p-4"><p class="text-xs uppercase tracking-wider text-zinc-500 mb-1">Water</p><p class="font-semibold text-warm-900">{tea.brewing.temp}</p></div>
          <div class="card p-4"><p class="text-xs uppercase tracking-wider text-zinc-500 mb-1">Vessel</p><p class="font-semibold text-warm-900 text-sm leading-snug">{tea.brewing.vessel}</p></div>
          <div class="card p-4"><p class="text-xs uppercase tracking-wider text-zinc-500 mb-1">Gongfu Time</p><p class="font-semibold text-warm-900">{tea.brewing.timeGongfu}</p></div>
          <div class="card p-4"><p class="text-xs uppercase tracking-wider text-zinc-500 mb-1">Western Time</p><p class="font-semibold text-warm-900">{tea.brewing.timeWestern}</p></div>
          <div class="card p-4"><p class="text-xs uppercase tracking-wider text-zinc-500 mb-1">Ratio</p><p class="font-semibold text-warm-900 text-sm leading-snug">{tea.brewing.ratio}</p></div>
          <div class="card p-4"><p class="text-xs uppercase tracking-wider text-zinc-500 mb-1">Infusions</p><p class="font-semibold text-warm-900">{tea.brewing.infusions}</p></div>
        </div>
        <a href="/guides/brewing/" class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:underline">Read the general brewing guide →</a>
      </div>
    </div>
  </section>

  <!-- Buying guide -->
  <section class="bg-paper-100 py-16">
    <div class="section-container">
      <SectionHeader eyebrow="Buying Guide" title={`How to Buy Sheng Pu-erh Without Getting Scammed`} subtitle="The Chinese tea market is vast and unregulated. Here's exactly what to look for — and what to run from." headingLevel="h2" />
      <div class="mt-8 grid md:grid-cols-2 gap-4">
        <div class="card p-5"><p class="text-xs uppercase tracking-wider text-zinc-500 mb-1">Entry Level</p><p class="font-semibold text-warm-900">{tea.buying.priceEntry}</p></div>
        <div class="card p-5"><p class="text-xs uppercase tracking-wider text-zinc-500 mb-1">Premium / Collector</p><p class="font-semibold text-warm-900">{tea.buying.priceAdvance}</p></div>
      </div>
      <div class="mt-6 grid md:grid-cols-2 gap-6">
        <div class="card p-6">
          <h3 class="flex items-center gap-2 font-semibold text-warm-900 mb-3"><span class="w-8 h-8 rounded-lg bg-leaf-100 text-accent flex items-center justify-center"><FaIcon icon={faCircleCheck} size={16} /></span> Quality Check</h3>
          <p class="text-sm text-muted leading-relaxed">{tea.buying.qualityCheck}</p>
        </div>
        <div class="card p-6">
          <h3 class="flex items-center gap-2 font-semibold text-warm-900 mb-3"><span class="w-8 h-8 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center"><FaIcon icon={faTriangleExclamation} size={16} /></span> Common Scams</h3>
          <p class="text-sm text-muted leading-relaxed">{tea.buying.commonScams}</p>
        </div>
      </div>
      <div class="mt-6 card p-6">
        <h3 class="font-semibold text-warm-900 mb-3">Search keywords that find the real thing</h3>
        <div class="flex flex-wrap gap-2">
          {tea.buying.searchKeywords.split(',').map((k) => (
            <span class="px-3 py-1 bg-white rounded-full border border-paper-200 text-xs text-warm-700">{k.trim()}</span>
          ))}
        </div>
      </div>
      <p class="mt-6 text-xs text-zinc-500">For the general principles behind every one of these checks — harvest dates, origin specificity, red flags — read our <a href="/guides/buying/" class="text-accent underline">complete buying guide</a>.</p>
    </div>
  </section>

  <!-- History + ideal for -->
  <section class="section-container py-16">
    <div class="grid lg:grid-cols-3 gap-10">
      <div class="lg:col-span-2 reveal">
        <SectionHeader eyebrow="History" title="Where It Comes From" headingLevel="h2" />
        <p class="mt-6 text-warm-700 leading-relaxed">{tea.history}</p>
        <div class="mt-8 card p-6 bg-leaf-50 border-leaf-200">
          <h3 class="font-semibold text-leaf-900 mb-1">Ideal For</h3>
          <p class="text-sm text-accent leading-relaxed">{tea.idealFor}</p>
        </div>
      </div>
      <aside class="reveal">
        <div class="card p-6 sticky top-24">
          <p class="text-xs uppercase tracking-wider text-zinc-500 mb-3">Quick Facts</p>
          <dl class="space-y-3 text-sm">
            <div><dt class="text-zinc-500 text-xs">Type</dt><dd class="text-warm-800 font-medium">{type?.name}</dd></div>
            <div><dt class="text-zinc-500 text-xs">Chinese name</dt><dd class="text-warm-800 font-medium">{tea.nameChinese}</dd></div>
            <div><dt class="text-zinc-500 text-xs">Origin</dt><dd class="text-warm-800 font-medium text-sm leading-snug">{tea.origin}</dd></div>
            <div><dt class="text-zinc-500 text-xs">Caffeine</dt><dd class="text-warm-800 font-medium">{tea.caffeine}</dd></div>
            <div><dt class="text-zinc-500 text-xs">Beginner friendliness</dt><dd class="text-warm-800 font-medium">{stars(tea.beginner)}</dd></div>
          </dl>
          <a href={`/types/${type?.slug}/`} class="mt-5 block text-center px-4 py-2.5 btn btn-primary text-sm">All {type?.nameShort} teas</a>
        </div>
      </aside>
    </div>
  </section>

  <!-- Related teas -->
  <section class="section-container pb-16">
    <SectionHeader eyebrow="You May Also Like" title="Related Teas" headingLevel="h2" />
    <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {related.map((r) => <TeaCard tea={r} />)}
    </div>
  </section>

  <CTACard primaryHref="/teas/" primaryLabel="Browse All Teas" secondaryHref="/guides/brewing/" secondaryLabel="Buying Guide" />

  <RelatedLinks links={[
    { href: `/types/${type?.slug}/`, label: `${type?.nameShort?.toLowerCase()} tea brewing guide` },
    { href: '/guides/storage/', label: 'how to store chinese tea' },
    { href: `/teas/${related[0]?.slug}/`, label: `${related[0]?.name?.toLowerCase()} comparison` },
    { href: '/guides/cold-brew/', label: 'cold brew this tea' },
  ]} />

</BaseLayout>
