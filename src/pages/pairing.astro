---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CTACard from '../components/CTACard.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { pairings } from '../data/content';
import { articleSchema } from '../data/schemas';
import FaIcon from '../components/FaIcon.astro';
import { faLeaf, faSeedling, faMugHot, faMugSaucer, faWineBottle, faBowlRice, type IconDefinition } from '@fortawesome/free-solid-svg-icons';
import LeadImage from '../components/LeadImage.astro';

const title = 'Chinese Tea & Food Pairing';
const description = 'Which Chinese tea goes with what food — green tea with seafood, oolongs with dim sum, pu-erh after heavy meals. A practical pairing guide per tea type.';

const schemaJson = JSON.stringify(articleSchema({
  title,
  description,
  canonicalURL: 'https://www.chin-tea.com/pairing',
  image: 'https://www.chin-tea.com/images/chinese-tea-og.webp',
  datePublished: '2026-08-01',
  dateModified: '2026-08-12',
}));

const icons: Record<string, IconDefinition> = {
  leaf: faLeaf,
  sprout: faSeedling,
  cup: faMugHot,
  mug: faMugSaucer,
  cake: faWineBottle,
  bowl: faBowlRice,
};
---

<BaseLayout {title} {description} schemaJson={schemaJson}>

  <section class="section-container pt-12 pb-4 reveal">
    <SectionHeader eyebrow="Pairings" title="Chinese Tea & Food Pairing" subtitle="The right tea elevates a meal. Each type of Chinese tea has natural food companions that bring out its best qualities — and a few things it pairs with poorly." headingLevel="h1" />
    <div class="mt-8"><LeadImage src="/images/chinese-tea-culture.webp" alt="Chinese tea ceremony setting" caption="Match intensity, follow the province" /></div>
  </section>

  <section class="section-container py-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
      {pairings.map((p) => (
        <div class={`card card-hover p-6 group ${p.border}`}>
          <div class="flex items-start gap-4 mb-4">
            <div class={`w-14 h-14 rounded-lg flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform ${p.tone}`}><span class="text-leaf-700/80"><FaIcon icon={icons[p.icon]} size={28} /></span></div>
            <div>
              <h3 class="font-semibold text-lg text-warm-900">{p.name}</h3>
              <p class="text-xs text-zinc-400 mt-0.5">{p.foods}</p>
            </div>
          </div>
          <p class="text-sm text-muted leading-relaxed">{p.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-paper-100 py-16">
    <div class="section-container max-w-3xl">
      <SectionHeader eyebrow="The Three Rules" title="Pairing Principles" headingLevel="h2" />
      <div class="mt-6 space-y-3">
        <div class="card p-5 flex gap-4"><span class="w-8 h-8 rounded-full bg-leaf-100 text-accent flex items-center justify-center text-sm font-bold flex-shrink-0">1</span><p class="text-sm text-muted leading-relaxed"><strong class="text-warm-900">Match intensity.</strong> Delicate teas (white, yellow, light green) go with delicate food. Bold teas (roasted oolong, black, pu-erh) can hold their own against strong flavors.</p></div>
        <div class="card p-5 flex gap-4"><span class="w-8 h-8 rounded-full bg-leaf-100 text-accent flex items-center justify-center text-sm font-bold flex-shrink-0">2</span><p class="text-sm text-muted leading-relaxed"><strong class="text-warm-900">Think about the aftertaste.</strong> A tea that cleanses — like pu-erh's earthy cut-through — earns its place after rich meals. A tea that lingers sweetly — like an oolong's hui gan — shines with lighter courses.</p></div>
        <div class="card p-5 flex gap-4"><span class="w-8 h-8 rounded-full bg-leaf-100 text-accent flex items-center justify-center text-sm font-bold flex-shrink-0">3</span><p class="text-sm text-muted leading-relaxed"><strong class="text-warm-900">Regional logic works.</strong> In China, teas are paired with local food: Longjing with Hangzhou's steamed fish, Tie Guan Yin with Fujian dim sum, shou pu-erh with Yunnan hot pot. When in doubt, follow the province.</p></div>
      </div>
    </div>
  </section>

  <CTACard primaryHref="/teas" primaryLabel="Find a Pairing Tea" secondaryHref="/culture" secondaryLabel="The Culture Behind It" />

  <RelatedLinks links={[
    { href: '/types/green', label: 'green tea with seafood' },
    { href: '/types/oolong', label: 'oolong with dim sum' },
    { href: '/types/dark', label: 'pu-erh after meals' },
    { href: '/types/black', label: 'keemun at breakfast' },
  ]} />

</BaseLayout>
