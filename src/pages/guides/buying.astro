---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import CTACard from '../../components/CTACard.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { buyingLookFor, buyingRedFlags, buyingPriceTable } from '../../data/content';
import { articleSchema } from '../../data/schemas';
import FaIcon from '../../components/FaIcon.astro';
import { faCircleCheck, faTriangleExclamation } from '@fortawesome/free-solid-svg-icons';
import LeadImage from '../../components/LeadImage.astro';

const title = 'How to Buy Authentic Chinese Tea';
const description = 'How to buy real Chinese tea without getting scammed — what to look for, red flags to avoid, realistic price ranges, and the exact quality checks for each tea type.';

const schemaJson = JSON.stringify(articleSchema({
  title,
  description,
  canonicalURL: 'https://chinese-tea.com/guides/buying',
  image: 'https://chinese-tea.com/images/chinese-tea-og.webp',
  datePublished: '2026-08-01',
  dateModified: '2026-08-12',
}));
---

<BaseLayout {title} {description} schemaJson={schemaJson}>

  <section class="section-container pt-12 pb-4 reveal">
    <SectionHeader eyebrow="Practical Advice" title="How to Buy Authentic Chinese Tea" subtitle="The Chinese tea market is vast and unregulated. Counterfeits are common. Here is how to shop with confidence — whether you buy online or in a shop." headingLevel="h1" />
    <div class="mt-8"><LeadImage src="/images/chinese-tea-culture.webp" alt="Chinese tea ceremony in a traditional setting" caption="Buy with confidence — know what you're looking for" /></div>
  </section>

  <section class="section-container py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="card p-6">
        <h3 class="font-semibold text-warm-900 mb-3 flex items-center gap-2"><span class="text-accent"><FaIcon icon={faCircleCheck} size={18} /></span> What to Look For</h3>
        <ul class="space-y-3 text-sm text-muted">
          {buyingLookFor.map((item) => (
            <li><strong class="text-warm-800">{item.strong}</strong> {item.body}</li>
          ))}
        </ul>
      </div>
      <div class="card p-6">
        <h3 class="font-semibold text-warm-900 mb-3 flex items-center gap-2"><span class="text-amber-600"><FaIcon icon={faTriangleExclamation} size={18} /></span> Red Flags to Avoid</h3>
        <ul class="space-y-3 text-sm text-muted">
          {buyingRedFlags.map((item) => (
            <li><strong class="text-warm-800">{item.strong}</strong> {item.body}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-paper-100 py-16">
    <div class="section-container">
      <SectionHeader eyebrow="Price Reality Check" title="Realistic Price Ranges by Tea Type" subtitle="Prices below these ranges are red flags. Premium Chinese teas cost more because skilled hand-processing is expensive." headingLevel="h2" center />
      <div class="mt-8 grid grid-cols-2 md:grid-cols-3 gap-3 max-w-4xl mx-auto">
        {buyingPriceTable.map((p) => (
          <div class="card p-4"><span class="block text-xs text-zinc-400 mb-0.5">{p.label}</span><span class="font-semibold text-warm-900">{p.range}</span><span class="block text-xs text-zinc-400">{p.note}</span></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-container py-16">
    <div class="max-w-3xl mx-auto">
      <SectionHeader eyebrow="Per-Tea Guides" title="Every Famous Tea Has Its Own Buying Guide" headingLevel="h2" />
      <p class="mt-4 text-muted leading-relaxed">General principles only get you so far. Each of our 15 famous tea pages includes tea-specific quality checks, common scams, search keywords, and realistic price entry points — so you know exactly what to ask for.</p>
      <div class="mt-8 grid grid-cols-2 md:grid-cols-3 gap-3">
        {['longjing', 'silver-needle', 'tie-guan-yin', 'da-hong-pao', 'pu-erh-sheng', 'dian-hong'].map((slug) => (
          <a href={`/teas/${slug}`} class="card card-hover p-4 no-underline block">
            <span class="font-medium text-warm-800">Read the {slug.replace(/-/g, ' ')} guide →</span>
          </a>
        ))}
      </div>
      <a href="/teas" class="mt-8 inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:underline">All 15 buying guides</a>
    </div>
  </section>

  <CTACard primaryHref="/teas" primaryLabel="Browse All Teas" secondaryHref="/guides/storage" secondaryLabel="Storage Guide" />

  <RelatedLinks links={[
    { href: '/guides/storage', label: 'how to store chinese tea' },
    { href: '/teas/pu-erh-shou', label: 'how to buy pu-erh' },
    { href: '/teas/longjing', label: 'how to spot fake longjing' },
    { href: '/guides/brewing', label: 'brew your new tea' },
    { href: '/teas/silver-needle', label: 'buying white tea' },
  ]} />

</BaseLayout>
