---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CTACard from '../components/CTACard.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { regions } from '../data/regions';
import { teas } from '../data/teas';
import { articleSchema } from '../data/schemas';
import LeadImage from '../components/LeadImage.astro';

const title = 'Chinese Tea by Region';
const description = 'Like wine, Chinese tea carries the character of its origin. Explore how Zhejiang, Fujian, Yunnan, Anhui, Jiangsu, and Guangdong shape the teas they produce.';

const schemaJson = JSON.stringify(articleSchema({
  title,
  description,
  canonicalURL: 'https://chinese-tea.com/regions',
  image: 'https://chinese-tea.com/images/chinese-tea-og.webp',
  datePublished: '2026-08-01',
  dateModified: '2026-08-12',
}));
---

<BaseLayout {title} {description} schemaJson={schemaJson}>

  <section class="section-container pt-12 pb-4 reveal">
    <SectionHeader eyebrow="Geography" title="Chinese Tea by Region" subtitle="Each province shapes its teas differently — the same cultivar can taste radically different on two mountains." headingLevel="h1" />
    <div class="mt-8"><LeadImage src="/images/chinese-tea-culture.webp" alt="Tea ceremony in a traditional setting" caption="Terroir in every cup" /></div>
  </section>

  <section class="section-container py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {regions.map((r) => (
        <div class="card card-hover p-0 overflow-hidden">
          <img src={r.image} alt={`${r.name} teas`} class="w-full aspect-[16/9] object-cover" loading="lazy" decoding="async" width="640" height="360" />
          <div class="p-6 md:p-7">
            <h3 class="font-display font-semibold text-2xl text-warm-900 mb-1">{r.name} <span class="text-base font-normal text-zinc-400">{r.nameZh}</span></h3>
            <p class="text-base text-warm-700 mb-3">{r.tagline}</p>
            <p class="text-base text-muted leading-relaxed mb-2"><strong class="text-warm-800">Terroir:</strong> {r.terroir}</p>
            <p class="text-base text-muted leading-relaxed mb-4"><strong class="text-warm-800">Tradition:</strong> {r.tradition}</p>
            <div class="flex flex-wrap gap-1.5">
              {r.teas.map((t) => <span class="px-2.5 py-0.5 text-sm rounded-full bg-paper-100 text-warm-700 border border-paper-200">{t.name}</span>)}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Taiwan -->
    <div class="mt-6 card p-0 overflow-hidden bg-leaf-50 border-leaf-200">
      <img src="/images/teas/tie-guan-yin.jpg" alt="Taiwan high-mountain oolong" class="w-full aspect-[16/9] object-cover" loading="lazy" decoding="async" width="640" height="360" />
      <div class="p-6 md:p-7">
        <h3 class="font-display font-semibold text-2xl text-warm-900 mb-1">Taiwan <span class="text-base font-normal text-zinc-400">台灣 — the island of high-mountain oolong</span></h3>
        <p class="text-base text-muted leading-relaxed mb-3">High-mountain (gaoshan) oolongs from Alishan, Lishan, and Dayuling grow above 1,000m in cool mist — creamy, floral, and famously smooth. Dong Ding is the island's classic roasted style, Baozhong the lightest, and Oriental Beauty an insect-bitten honey tea. All share the same plant and <a href="/types/oolong" class="text-accent underline">qing cha classification</a> as mainland oolongs.</p>
        <div class="flex flex-wrap gap-1.5">
          {['Alishan', 'Lishan', 'Dayuling', 'Dong Ding', 'Baozhong', 'Oriental Beauty'].map((t) => <span class="px-2.5 py-0.5 text-sm rounded-full bg-white text-warm-700 border border-leaf-200">{t}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-paper-100 py-16">
    <div class="section-container max-w-3xl">
      <SectionHeader eyebrow="Terroir" title="Why Origin Matters" headingLevel="h2" />
      <div class="mt-6 space-y-4 text-base text-muted leading-relaxed">
        <p class="card p-6">China has two terms for this. <strong class="text-warm-900">Yan yun</strong> (岩韵, "rock rhythm") describes the mineral character Wuyi Mountain's volcanic soil gives its rock teas. <strong class="text-warm-900">Shan yun</strong> (山韵, "mountain charm") describes the altitude- and mist-driven depth of high-mountain teas. Neither can be replicated off the mountain — which is exactly why genuine origin matters so much.</p>
        <p class="card p-6">When a vendor can name the specific mountain, village, or even the side of a valley, they are telling you the tea has a terroir story worth paying for. When a tea is just "green tea from China," assume it is bulk commodity leaf.</p>
      </div>
    </div>
  </section>

  <section class="section-container py-16">
    <SectionHeader eyebrow="From the Fields" title="Teas You Can Taste Right Now" headingLevel="h2" />
    <div class="mt-8 grid grid-cols-2 md:grid-cols-4 gap-3">
      {teas.map((t) => (
        <a href={`/teas/${t.slug}`} class="card card-hover p-4 no-underline block">
          <span class="text-base font-medium text-warm-800">{t.name}</span>
          <span class="block text-sm text-muted mt-0.5">{t.origin}</span>
        </a>
      ))}
    </div>
  </section>

  <CTACard primaryHref="/types" primaryLabel="Compare the Six Types" secondaryHref="/culture" secondaryLabel="Tea Culture" />

  <RelatedLinks links={[
    { href: '/types/green', label: 'zhejiang green teas' },
    { href: '/types/oolong', label: 'high mountain oolong tea' },
    { href: '/types/oolong', label: 'qing cha blue tea explained' },
    { href: '/types/dark', label: 'yunnan pu-erh' },
    { href: '/types/black', label: 'yunnan black tea' },
  ]} />

</BaseLayout>
