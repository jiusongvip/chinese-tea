---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import TypeCard from '../components/TypeCard.astro';
import TeaCard from '../components/TeaCard.astro';
import FinderWidget from '../components/FinderWidget.astro';
import BrewingTabs from '../components/BrewingTabs.astro';
import CTACard from '../components/CTACard.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import FaqList from '../components/FaqList.astro';
import { getTeaType } from '../data/teaTypes';
import { teas } from '../data/teas';
import { faqs } from '../data/faq';
import { comparisonRows, heroSteps, cultureFacts, relatedSearchLinks, cultureEntries } from '../data/content';
import { FlaskConical, BadgeCheck, HandCoins, SearchX, ArrowRight } from '@lucide/astro';

const title = 'Chinese Tea Guide: Types, Brewing & Culture';
const description = 'The practical guide to Chinese tea: six types, 21 famous teas, brewing and buying guides, regions, and how to choose the right tea for your taste.';

const heroNav = [
  { label: 'Types', href: '/types/' },
  { label: 'Flavours', href: '/flavours/' },
  { label: 'Teas', href: '/teas/' },
  { label: 'Brewing', href: '/guides/brewing/' },
  { label: 'Regions', href: '/regions/' },
  { label: 'Buying', href: '/guides/buying/' },
];

const schemaJson = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    url: 'https://www.chin-tea.com/',
    inLanguage: 'en',
    datePublished: '2026-08-01',
    dateModified: '2026-08-12',
    author: { '@type': 'Organization', name: 'Chinese Tea Guide', url: 'https://www.chin-tea.com/about/' },
    publisher: { '@type': 'Organization', name: 'Chinese Tea Guide', url: 'https://www.chin-tea.com/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: teas.map((t, i) => ({
      '@type': 'Product',
      name: t.name,
      url: `https://www.chin-tea.com/teas/${t.slug}/`,
      position: i + 1,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.slice(0, 6).map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
]);
---

<BaseLayout {title} {description} schemaJson={schemaJson} preloadImage="/images/chinese-tea-hero.avif">

  <!-- Hero — the ceremonial stage (Hamada-style three-zone composition) -->
  <section class="relative min-h-[100dvh] overflow-hidden bg-[#f7faf8]">
    <!-- Photo backdrop with a pale ceremonial wash -->
    <div class="absolute inset-0">
      <img src="/images/chinese-tea-hero.avif" alt="Chinese tea ceremony scene with a clay teapot, cups, and loose leaf tea on a wooden table" class="w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="async" width="1920" height="1080" />
      <div class="absolute inset-0 bg-gradient-to-b from-[#f7faf8]/60 via-[#f7faf8]/75 to-[#f7faf8]/95" aria-hidden="true"></div>
    </div>
    <canvas id="js-canvas-container" class="absolute inset-0 w-full h-full" aria-hidden="true"></canvas>

    <!-- Top bar: horizontal brand + quick navigation (English-first) -->
    <div class="absolute top-0 inset-x-0 px-8 xl:px-14 py-6 z-10 flex items-center justify-between">
      <a href="/" class="inline-flex items-center gap-3 no-underline" aria-label="Chinese Tea Guide home">
        <span class="w-9 h-9 rounded-[5px] bg-red-600 text-paper-50 grid place-items-center text-xl leading-none select-none shadow-[0_2px_6px_rgba(160,58,31,0.35)]" aria-hidden="true">茶</span>
        <span class="font-accent text-xl font-semibold tracking-tight text-ink-900">Chinese Tea</span>
      </a>
      <nav class="hidden md:flex items-center gap-8" aria-label="Hero quick links">
        {heroNav.map((l) => (
          <a href={l.href} class="font-mono text-[11px] font-medium uppercase tracking-[0.18em] text-ink-600 hover:text-accent transition-colors">{l.label}</a>
        ))}
      </nav>
    </div>

    <!-- Bottom-center: the headline, modest width, centered -->
    <div class="absolute inset-x-0 top-[62%] lg:top-[72%] -translate-y-1/2 px-6 z-10">
      <div class="max-w-4xl mx-auto text-center">
        <p class="flex items-center justify-center gap-3 font-mono text-xs font-medium tracking-[0.3em] uppercase text-accent mb-6">
          <span class="inline-block w-8 h-px bg-accent/50"></span>
          Chinese Tea Guide
          <span class="inline-block w-8 h-px bg-accent/50"></span>
        </p>
        <h1 class="font-accent text-4xl md:text-5xl lg:text-[4.2rem] font-semibold tracking-tight leading-[1.06] text-ink-900">
          From six types to your perfect cup
        </h1>
        <p class="mt-7 text-base md:text-lg text-warm-600 leading-relaxed max-w-2xl mx-auto">
          Every type of Chinese tea comes from one plant — and everything else is craft. Practical guides to 21 famous teas, exact brewing temperatures, buying tips, and the culture behind 4,000 years of drinking.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/teas/" class="inline-flex items-center justify-center gap-2 px-8 py-3.5 btn btn-primary text-base">Find Your Tea</a>
          <a href="/types/" class="inline-flex items-center justify-center gap-2 px-8 py-3.5 btn btn-outline-ink text-base">Explore the Six Types</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Tea Detail Pages — every tea with its own guide, right under the hero -->
  <section class="py-20">
    <div class="section-container">
      <div class="flex items-end justify-between mb-10 reveal">
        <SectionHeader eyebrow="Tea Explorer" title="Tea Detail Pages" subtitle="Twenty-one iconic teas — each with its own page covering flavor profile, exact brewing parameters, buying tips, common scams, and history." headingLevel="h2" />
        <a href="/teas/" class="hidden md:inline-flex items-center gap-1.5 text-sm text-accent hover:underline flex-shrink-0 ml-6">View all 21</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {teas.map((t) => <TeaCard tea={t} />)}
      </div>
    </div>
  </section>

  <!-- Interactive explorer — moved to /compare/; compact teaser keeps the homepage lean -->
  <section class="py-12 bg-gradient-to-b from-paper-100 to-white">
    <div class="section-container">
      <div class="text-center mb-8 reveal">
        <SectionHeader eyebrow="Compare &amp; Search" title="Explore Every Tea Side by Side" subtitle="All 21 famous teas in one filterable table — flavour, brewing parameters, caffeine, and price at a glance." headingLevel="h2" center />
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 max-w-3xl mx-auto reveal">
        {teas.slice(0, 6).map((t) => (
          <a href={`/teas/${t.slug}/`} class="card flex items-center gap-3 px-4 py-3 no-underline group">
            <span class="font-display font-semibold text-warm-800 text-sm flex-1">{t.name}</span>
            <span class="font-mono text-[10px] uppercase tracking-wider text-accent opacity-0 group-hover:opacity-100 transition-opacity">view →</span>
          </a>
        ))}
      </div>
      <div class="text-center mt-8 reveal">
        <a href="/compare/" class="inline-flex items-center gap-2 px-8 py-3.5 btn btn-primary">Open the Full Comparison Table<ArrowRight class="w-4 h-4" /></a>
        <p class="text-sm text-muted mt-4">Filter by type, search by flavour, expand any row for brewing and buying details.</p>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var canvas = document.getElementById("js-canvas-container");
      if (!canvas || window.matchMedia("(prefers-reduced-motion: reduce)").matches || !window.matchMedia("(min-width: 768px)").matches) return;
      var ctx = canvas.getContext("2d");
      var ink = [28, 25, 21];
      var particles = [];
      var w, h;
      function resize() {
        w = canvas.width = canvas.offsetWidth;
        h = canvas.height = canvas.offsetHeight;
        var count = Math.min(70, Math.floor((w * h) / 26000));
        particles = [];
        for (var i = 0; i < count; i++) {
          particles.push({
            x: Math.random() * w,
            y: Math.random() * h,
            r: 0.6 + Math.random() * 1.8,
            v: 0.08 + Math.random() * 0.28,
            a: 0.05 + Math.random() * 0.16,
            drift: (Math.random() - 0.5) * 0.12,
          });
        }
      }
      resize();
      window.addEventListener("resize", resize);
      function tick() {
        ctx.clearRect(0, 0, w, h);
        for (var i = 0; i < particles.length; i++) {
          var p = particles[i];
          p.y -= p.v;
          p.x += p.drift;
          if (p.y < -6) { p.y = h + 6; p.x = Math.random() * w; }
          if (p.x < -6) p.x = w + 6;
          if (p.x > w + 6) p.x = -6;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fillStyle = "rgba(" + ink[0] + "," + ink[1] + "," + ink[2] + "," + p.a + ")";
          ctx.fill();
        }
        requestAnimationFrame(tick);
      }
      tick();
    })();
  </script>

  <!-- Why this guide exists -->
  <section class="max-w-[800px] mx-auto px-6 py-16 reveal">
    <p class="text-sm font-medium tracking-wide text-accent/80 mb-3">Why This Guide Exists</p>
    <p class="text-warm-700 leading-relaxed">
      Most search results for Chinese tea give you one of three things: a <strong>Wikipedia-level overview</strong> (authoritative but impersonal), a <strong>commerce site</strong> trying to sell you tea (biased toward their inventory), or a <strong>surface-level listicle</strong> with photos and one-sentence descriptions (shallow on practical details).
    </p>
    <p class="text-warm-700 leading-relaxed mt-4">
      This guide does what none of them do: it gives you <strong>actionable, experience-based information</strong> — exact brewing temperatures, realistic price ranges, common scams per tea, and quality checks — without any commercial agenda. Six types. Twenty-one famous teas. Every one with a full buying and brewing guide. Built for someone who genuinely wants to understand Chinese tea.
    </p>
  </section>

  <!-- 3-step guide -->
  <section class="section-container pb-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {heroSteps.map((s, i) => (
        <a href={s.href} class="group card card-hover p-5 no-underline block">
          <div class="w-10 h-10 rounded-full bg-leaf-100 text-accent flex items-center justify-center font-accent font-semibold mx-auto mb-3 group-hover:bg-leaf-600 group-hover:text-white transition-colors">{i + 1}</div>
          <h3 class="font-semibold text-center text-warm-900 mb-1">{s.title}</h3>
          <p class="text-sm text-center text-muted">{s.body}</p>
        </a>
      ))}
    </div>
    <p class="text-center mt-6 text-sm text-muted">Completely new to tea? <a href="/guides/beginners/" class="text-accent underline">Start with the beginner's guide</a> — it's the shortest path to a proper cup.</p>
  </section>

  <!-- Quick comparison -->
  <section class="section-container pb-20">
    <div class="text-center mb-8 reveal">
      <SectionHeader eyebrow="At a Glance" title="Quick Comparison" headingLevel="h2" center />
    </div>
    <div class="overflow-x-auto rounded-xl border border-paper-200 bg-white reveal">
      <table class="w-full text-sm min-w-[760px]">
        <thead>
          <tr class="bg-paper-100 text-left">
            <th class="px-5 py-3.5 font-mono text-[11px] uppercase tracking-[0.15em] text-warm-500">Type</th>
            <th class="px-5 py-3.5 font-mono text-[11px] uppercase tracking-[0.15em] text-warm-500">Oxidation</th>
            <th class="px-5 py-3.5 font-mono text-[11px] uppercase tracking-[0.15em] text-warm-500">Caffeine</th>
            <th class="px-5 py-3.5 font-mono text-[11px] uppercase tracking-[0.15em] text-warm-500">Brew Temp</th>
            <th class="px-5 py-3.5 font-mono text-[11px] uppercase tracking-[0.15em] text-warm-500">Beginner</th>
            <th class="px-5 py-3.5 font-mono text-[11px] uppercase tracking-[0.15em] text-warm-500">Price Range</th>
          </tr>
        </thead>
        <tbody>
          {comparisonRows.map((row, i) => {
            const type = getTeaType(row.href.split('/').pop() ?? 'green');
            const caffeineTone = row.caffeine.includes('High')
              ? 'text-rose-700 bg-rose-50 border-rose-100'
              : row.caffeine.includes('Low')
                ? 'text-leaf-700 bg-leaf-50 border-leaf-100'
                : 'text-amber-700 bg-amber-50 border-amber-100';
            return (
              <tr class={`${i % 2 === 0 ? 'bg-white' : 'bg-paper-100/40'} hover:bg-leaf-50/60 transition-colors`}>
                <td class="px-5 py-3 font-medium text-warm-800 whitespace-nowrap">
                  <a href={row.href} class="inline-flex items-center gap-2.5 no-underline group">
                    <span class={`w-2.5 h-2.5 rounded-full flex-shrink-0 ${type?.accent.bg ?? 'bg-leaf-500'}`} aria-hidden="true"></span>
                    <span class="group-hover:text-accent group-hover:underline">{row.type}</span>
                  </a>
                </td>
                <td class="px-5 py-3 text-muted whitespace-nowrap">{row.oxidation}</td>
                <td class="px-5 py-3 whitespace-nowrap"><span class={`inline-flex px-2 py-0.5 rounded-full text-xs font-medium border ${caffeineTone}`}>{row.caffeine}</span></td>
                <td class="px-5 py-3 text-muted whitespace-nowrap">{row.brewTemp}</td>
                <td class="px-5 py-3 whitespace-nowrap">
                  <span class="text-amber-400" aria-label={`${row.beginner} out of 5 beginner-friendly`}>{'★★★★★'.slice(0, row.beginner)}</span><span class="text-paper-200">{'★★★★★'.slice(0, 5 - row.beginner)}</span>
                </td>
                <td class="px-5 py-3 text-muted whitespace-nowrap">{row.price}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-xs text-zinc-400 text-center">★ = beginner-friendly scale (5 = great starting point). Prices are loose-leaf ranges from specialist vendors; premium and collector lots cost far more.</p>
  </section>

  <!-- Find your tea -->
  <section class="py-20 bg-gradient-to-b from-white to-paper-100">
    <div class="section-container">
      <div class="text-center mb-12 reveal">
        <SectionHeader eyebrow="Interactive" title="Find Your Chinese Tea" subtitle="Not sure where to start? Tell us what you like, and we'll recommend the right Chinese tea for your palate." headingLevel="h2" center />
      </div>
      <FinderWidget />
      <p class="text-center mt-6 text-sm text-muted">Prefer to browse? Explore every tea organized by taste in the <a href="/flavours/" class="text-accent underline">Chinese Tea Flavour Guide</a>.</p>
    </div>
  </section>

  <!-- Brewing -->
  <section class="py-20 bg-paper-100">
    <div class="section-container">
      <div class="text-center mb-12 reveal">
        <SectionHeader eyebrow="How To" title="How to Brew Chinese Tea" subtitle="Each tea type has its own ideal temperature, time, and vessel. Master the basics for a perfect cup every time." headingLevel="h2" center />
      </div>
      <BrewingTabs />
      <div class="text-center mt-10">
        <a href="/guides/brewing/" class="inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:underline">Full brewing guide — water, cold brew & teaware</a>
      </div>
    </div>
  </section>

  <!-- Regions teaser -->
  <section class="py-20 reveal">
    <div class="section-container">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <SectionHeader eyebrow="Geography" title="Chinese Tea by Region" subtitle="Like wine, Chinese tea carries the character of its origin. Each province produces teas with distinct terroir and tradition — from Longjing's chestnut aroma in Zhejiang to Pu-erh's ancient forests in Yunnan." headingLevel="h2" />
          <div class="mt-8 flex flex-wrap gap-3">
            {['Zhejiang', 'Fujian', 'Yunnan', 'Anhui', 'Jiangsu', 'Guangdong'].map((r) => (
              <a href="/regions/" class="px-4 py-2 border border-paper-200 rounded-full text-sm text-warm-700 hover:text-accent hover:border-leaf-300 hover:bg-leaf-50/60 transition">{r}</a>
            ))}
          </div>
        </div>
        <div class="relative">
          <div class="absolute -inset-4 rounded-xl bg-gradient-to-br from-leaf-200/40 to-amber-200/20 blur-2xl"></div>
          <img src="/images/chinese-tea-hero.webp" alt="Gongfu tea brewing with hot water being poured into a gaiwan" class="relative rounded-xl shadow-xl w-full" loading="lazy" width="800" height="533" />
        </div>
      </div>
    </div>
  </section>

  <!-- Culture teaser -->
  <section class="bg-leaf-950 py-20 text-white">
    <div class="section-container">
      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <div class="reveal">
          <SectionHeader eyebrow="Tradition" title="Chinese Tea Culture & Ceremony" subtitle="Tea in China is far more than a drink — it's woven into daily life, art, poetry, and philosophy. For over 4,000 years, tea has been a medium for hospitality, meditation, and social connection." headingLevel="h2" dark />
          <blockquote class="pullquote text-leaf-200 mt-8 border-l-2 border-leaf-600 pl-6">“<span lang="zh">茶者，南方之嘉木也</span> — Tea is a noble tree of the south.”<footer class="mt-3 text-sm not-italic font-normal text-leaf-300/70">— Lu Yu, <a href="https://en.wikipedia.org/wiki/The_Classic_of_Tea" target="_blank" rel="noopener" class="underline hover:text-white">The Classic of Tea</a>, c. 760 CE</footer></blockquote>
          <div class="mt-8 space-y-4">
            {cultureEntries.slice(0, 3).map((e) => (
              <div class="flex gap-4">
                <div class="w-10 h-10 rounded-lg bg-leaf-800 flex items-center justify-center flex-shrink-0 text-leaf-300 mt-0.5">{e.mark}</div>
                <div>
                  <h3 class="font-semibold text-white mb-1">{e.title}</h3>
                  <p class="text-sm text-leaf-100/70 line-clamp-3">{e.body}</p>
                </div>
              </div>
            ))}
          </div>
          <a href="/culture/" class="mt-8 inline-flex items-center gap-1.5 text-sm font-medium text-leaf-300 hover:text-white transition-colors">Read the full culture guide →</a>
        </div>
        <div class="bg-leaf-900/50 rounded-xl border border-leaf-800 p-8 reveal">
          <img src="/images/chinese-tea-culture.webp" alt="Chinese tea ceremony in a traditional setting" class="w-full rounded-lg mb-5" loading="lazy" width="800" height="533" />
          <h3 class="font-semibold text-lg text-white mb-4">Tea Culture Quick Facts</h3>
          <ul class="space-y-3 text-sm text-leaf-100/80">
            {cultureFacts.map((f, i) => (
              <li class="flex gap-3"><span class="text-leaf-400 font-mono">{String(i + 1).padStart(2, '0')}</span> {f}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust signals -->
  <section class="section-container py-20 reveal">
    <SectionHeader eyebrow="Why Trust This Site" title="Written by People Who Drink the Tea" subtitle="The bar is high for advice you're going to act on. Here's how we meet it." headingLevel="h2" />
    <p class="text-center text-sm text-muted mt-4">Written and blind-tasted by the <a href="/about/" class="text-accent hover:underline">Chinese Tea Guide</a> team &middot; Last updated <time datetime="2026-08-12">August 12, 2026</time>.</p>
    <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      <div class="border-t-2 border-accent pt-4"><div class="flex items-center gap-2 mb-2"><BadgeCheck class="w-5 h-5 text-accent flex-shrink-0" /><h3 class="font-semibold text-lg">Verified Parameters</h3></div><p class="text-sm text-muted leading-relaxed">Every temperature, price, and ratio is based on direct market data and re-checked quarterly.</p></div>
      <div class="border-t-2 border-accent pt-4"><div class="flex items-center gap-2 mb-2"><FlaskConical class="w-5 h-5 text-accent flex-shrink-0" /><h3 class="font-semibold text-lg">Blind Tasted</h3></div><p class="text-sm text-muted leading-relaxed">Every tea is brewed blind, multiple ways, before it earns a recommendation. We buy at market prices — never free samples.</p></div>
      <div class="border-t-2 border-accent pt-4"><div class="flex items-center gap-2 mb-2"><HandCoins class="w-5 h-5 text-accent flex-shrink-0" /><h3 class="font-semibold text-lg">No Sponsorships</h3></div><p class="text-sm text-muted leading-relaxed">We accept no sponsorships from vendors and earn no commissions on teas we recommend.</p></div>
      <div class="border-t-2 border-accent pt-4"><div class="flex items-center gap-2 mb-2"><SearchX class="w-5 h-5 text-accent flex-shrink-0" /><h3 class="font-semibold text-lg">No AI Fluff</h3></div><p class="text-sm text-muted leading-relaxed">Every paragraph answers a real question a tea drinker would ask. No padding, no recycled text.</p></div>
    </div>
  </section>

  <CTACard primaryHref="/teas/" primaryLabel="Browse All Teas" secondaryHref="/guides/buying/" secondaryLabel="Read the Buying Guide" />

  <RelatedLinks links={relatedSearchLinks} />

  <!-- Sources: outbound citations for AI citability -->
  <section class="section-container pb-4">
    <h2 class="font-display text-lg font-semibold text-warm-800 mb-4">Sources &amp; Further Reading</h2>
    <ul class="text-sm text-muted space-y-2 max-w-2xl">
      <li>Lu Yu, <a href="https://en.wikipedia.org/wiki/The_Classic_of_Tea" target="_blank" rel="noopener" class="text-accent hover:underline">The Classic of Tea (茶经)</a> — the first monograph on tea, c. 760 CE.</li>
      <li><a href="https://en.wikipedia.org/wiki/Chinese_tea" target="_blank" rel="noopener" class="text-accent hover:underline">Chinese tea</a> — history, classification, and cultural background (Wikipedia).</li>
      <li><a href="https://en.wikipedia.org/wiki/Tea" target="_blank" rel="noopener" class="text-accent hover:underline">Tea</a> — processing methods, chemistry (catechins, L-theanine), and global history (Wikipedia).</li>
    </ul>
  </section>

  <!-- FAQ preview -->
  <section class="section-container py-20">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-12 reveal">
        <SectionHeader eyebrow="Questions" title="Frequently Asked Questions" headingLevel="h2" center />
      </div>
      <FaqList faqs={faqs.slice(0, 6)} />
      <div class="text-center mt-8">
        <a href="/faq/" class="inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:underline">All {faqs.length} questions & answers</a>
      </div>
    </div>
  </section>

</BaseLayout>
