const qaPageSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "QAPage",
  "mainEntity": {
    "@type": "Question",
    "name": "Which Chinese tea is best for beginners?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "For beginners, we recommend starting with White Tea (light, forgiving to brew) or Tie Guan Yin Oolong (floral, approachable). If you prefer something familiar to Western black tea, try Keemun (smooth, malty). If you enjoy green tea, Longjing (Dragon Well) is the most famous and a great starting point."
    }
  }
});

