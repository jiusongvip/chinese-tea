<script>
  (function(){var links=document.querySelectorAll('nav a[href^="#"]');var sections=[];links.forEach(function(l){var id=l.getAttribute('href').replace('#','');var s=document.getElementById(id);if(s)sections.push({section:s,link:l})});var observer=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){links.forEach(function(l){l.classList.remove('nav-active')});var match=sections.find(function(s){return s.section===e.target});if(match)match.link.classList.add('nav-active')}})},{rootMargin:'-20% 0px -70% 0px'});sections.forEach(function(s){observer.observe(s.section)})})();
</script>

