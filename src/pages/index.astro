---
import BaseLayout from "../layouts/BaseLayout.astro";

const faqData = [
  { q: "What is Chinese tea?", a: "Chinese tea refers to tea produced from the leaves of the Camellia sinensis plant using traditional Chinese processing methods. Unlike many Western teas, Chinese tea is categorized by processing method rather than region alone, resulting in six distinct types: green, white, yellow, oolong, black, and dark (post-fermented) tea. China is the birthplace of tea culture, with a history spanning over 4,000 years." },
  { q: "How many types of Chinese tea are there?", a: "There are six major categories of Chinese tea, distinguished by their oxidation level and processing method: <strong>Green Tea</strong> (unoxidized, fresh, vegetal), <strong>White Tea</strong> (minimally processed, delicate), <strong>Yellow Tea</strong> (lightly oxidized, mellow, rare), <strong>Oolong Tea</strong> (partially oxidized, from floral to roasted), <strong>Black Tea</strong> (fully oxidized, malty, robust — called hong cha/'red tea' in Chinese), and <strong>Dark Tea</strong> (post-fermented, earthy, aged like Pu-erh)." },
  { q: "Which Chinese tea is best for beginners?", a: "For beginners, we recommend starting with <strong>White Tea</strong> (light, forgiving to brew) or <strong>Tie Guan Yin Oolong</strong> (floral, approachable). If you prefer something familiar to Western black tea, try <strong>Keemun</strong> (smooth, malty). If you enjoy green tea, <strong>Longjing (Dragon Well)</strong> is the most famous and a great starting point. The key is to match the tea to your existing taste preferences — use our <a href='#finder' class='text-leaf-600 underline'>Find Your Tea tool</a> above." },
  { q: "How do you brew Chinese tea?", a: "Chinese tea brewing varies by type, but the general method — <strong>gongfu style</strong> — uses a small teapot or gaiwan with a high leaf-to-water ratio and multiple short infusions. Key factors: <strong>water temperature</strong> (160°F-212°F depending on tea type), <strong>steeping time</strong> (10-60 seconds for gongfu, 2-5 minutes for Western style), and <strong>quality water</strong> (spring or filtered). See our <a href='#brewing' class='text-leaf-600 underline'>Brewing Guide</a> for detailed instructions per tea type." },
  { q: "What is the difference between Chinese tea and Japanese tea?", a: "Chinese tea is almost entirely pan-fired or wok-roasted to halt oxidation, resulting in toasty, nutty flavors. Japanese green teas are <strong>steamed</strong>, producing a vegetal, umami-rich profile. Chinese tea culture emphasizes variety (six categories) and the gongfu ceremony, while Japan focuses primarily on green tea (matcha, sencha, gyokuro) and the chanoyu tea ceremony. Chinese oolongs and pu-erhs have no Japanese equivalent." },
  { q: "Is Chinese tea healthy?", a: "Chinese tea, particularly green and white varieties, is rich in antioxidants (catechins, EGCG), L-theanine (promotes calm focus), and moderate caffeine. Studies suggest regular tea consumption may support heart health, metabolism, and cognitive function. However, tea should complement — not replace — a balanced diet and healthy lifestyle. Consult a healthcare professional for specific health concerns." },
  { q: "Where can I buy authentic Chinese tea?", a: "Look for vendors who specify the harvest date, origin (specific mountain/village), and cultivar. Reputable online sources include specialty tea shops that import directly from Chinese tea farms. Avoid generic 'Chinese tea' blends from supermarkets — they are rarely fresh or authentic. For specific recommendations, explore our <a href='#famous' class='text-leaf-600 underline'>Famous Teas section</a> to know what to look for." },
  { q: "What is gongfu tea ceremony?", a: "Gongfu cha (功夫茶, 'tea made with skill') is a traditional Chinese brewing method that uses a small clay teapot or gaiwan, a high leaf-to-water ratio, and multiple short infusions (often 5-10+). It emphasizes appreciating the tea's evolving flavor across steepings. Unlike the formal Japanese tea ceremony, gongfu cha is more focused on the tea itself than ritual — it can be practiced casually at home or formally." },
  { q: "How should I store Chinese tea?", a: "Store tea in an <strong>airtight, opaque container</strong> away from light, heat, moisture, and strong odors. Avoid the fridge for most teas (condensation ruins them). Green and lightly oxidized teas are best consumed within 6-12 months. Dark teas (Pu-erh) and aged whites improve with time if stored in a breathable environment (not sealed plastic). A dedicated tea cabinet or dark cupboard at room temperature is ideal." },
  { q: "Can I reuse Chinese tea leaves?", a: "Absolutely — this is one of the best things about loose leaf Chinese tea. Most quality teas can be steeped <strong>3-8+ times</strong>, with each infusion revealing different flavors. Gongfu-style brewing is specifically designed for multiple infusions. Western-style brewing typically yields 2-3 good steeps. The key is to increase steeping time slightly with each round. Green teas: 3-4 infusions. Oolongs: 5-8 infusions. Pu-erh: 8-15+ infusions." },
  { q: "What does 'hui gan' (回甘) mean?", a: "<strong>Hui gan</strong> (回甘, 'returning sweetness') is one of the most prized qualities in Chinese tea. It refers to the <strong>sweet aftertaste that emerges in your throat</strong> after swallowing — distinct from the initial sweetness on your tongue. A tea with good hui gan starts slightly bitter or astringent, then transforms into a lingering, cooling sweetness that can last for minutes. It's a key quality indicator in oolongs, pu-erhs, and premium green teas." },
  { q: "Is loose leaf Chinese tea better than tea bags?", a: "<strong>Almost always, yes.</strong> Tea bags typically contain broken leaf fragments (fannings or dust) that release tannins quickly, resulting in a bitter, one-dimensional brew. Loose leaf tea uses intact leaves that unfurl gradually, releasing complex flavors across multiple infusions. The difference is comparable to instant coffee vs. freshly ground beans. Even a budget loose leaf Chinese tea will outperform premium tea bags. That said, the best tea is the one you’ll actually brew — if convenience matters, look for whole-leaf pyramid sachets as a middle ground." },
  { q: "How much caffeine is in Chinese tea compared to coffee?", a: "An 8oz cup of coffee contains ~95mg of caffeine. Chinese tea varies widely by type and brewing method: <strong>Green tea:</strong> 25-35mg (light, refreshing energy), <strong>White tea:</strong> 15-25mg (gentlest lift), <strong>Oolong:</strong> 30-45mg, <strong>Black tea:</strong> 40-60mg, <strong>Pu-erh:</strong> 40-70mg. Crucially, tea also contains <strong>L-theanine</strong>, an amino acid that promotes calm focus and counteracts caffeine jitters. This is why tea drinkers describe the energy as 'alert calm' rather than the spike-and-crash of coffee." }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqData.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a.replace(/<[^>]*>/g, "") },
  })),
});

// Article Schema

