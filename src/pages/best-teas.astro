---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CTACard from '../components/CTACard.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { getTea, type Tea } from '../data/teas';
import { getTeaType } from '../data/teaTypes';
import { articleSchema } from '../data/schemas';
import TeaVisual from '../components/TeaVisual.astro';
import { ArrowRight } from '@lucide/astro';

const title = 'The Best Chinese Teas: Our Top Picks by Category';
const description = 'The best Chinese teas to try first — ranked by beginner-friendliness, fame, and value. Best green, oolong, black, white, dark, and yellow tea picks, with why each one makes the list.';

const topTen = [
  { slug: 'longjing', reason: "China's most famous tea and the best place to start with greens — nutty, smooth, and endlessly drinkable." },
  { slug: 'tie-guan-yin', reason: "The perfect entry oolong: floral, creamy, and built for the gongfu method it helped popularize." },
  { slug: 'silver-needle', reason: "The gentlest tea on earth and the most forgiving to brew — the purest expression of the leaf." },
  { slug: 'keemun', reason: "The bridge from Western black tea — malty and smooth with a winey, floral depth." },
  { slug: 'anji-bai-cha', reason: "A modern classic: albino leaves give it an umami sweetness with zero bitterness." },
  { slug: 'biluochun', reason: "The fruity green — apricot and flowers in a cup, one of China's Ten Famous Teas." },
  { slug: 'dian-hong', reason: "The sweetest black tea — cocoa and sweet potato, thick enough to drink plain or with milk." },
  { slug: 'da-hong-pao', reason: "The legendary rock oolong — a taste of Wuyi's mineral 'rock rhyme' and charcoal depth." },
  { slug: 'pu-erh-shou', reason: "The coffee drinker's tea — earthy, smooth, and warming, with an almost chewy body." },
  { slug: 'huangshan-maofeng', reason: "A floral green from Yellow Mountain — orchid notes and a long, sweet finish." },
];

const bestByCategory = [
  { type: 'green', label: 'Best Green Tea', slug: 'longjing', note: 'Runner-up: Anji Bai Cha' },
  { type: 'white', label: 'Best White Tea', slug: 'silver-needle', note: 'Runner-up: White Peony' },
  { type: 'yellow', label: 'Best Yellow Tea', slug: 'junshan-yinzhen', note: 'Genuinely rare' },
  { type: 'oolong', label: 'Best Oolong Tea', slug: 'tie-guan-yin', note: 'Runner-up: Da Hong Pao' },
  { type: 'black', label: 'Best Black Tea', slug: 'keemun', note: 'Runner-up: Dian Hong' },
  { type: 'dark', label: 'Best Dark Tea', slug: 'pu-erh-shou', note: 'Runner-up: Sheng Pu-erh' },
];

const specialPicks = [
  { title: 'Best Value', slug: 'gunpowder-green', body: 'Big character, tiny price — the workhorse green.' },
  { title: 'Best Splurge', slug: 'jin-jun-mei', body: 'Bud-only Wuyi black tea with honey and lychee — made for celebrating.' },
  { title: 'Best for Cold Brew', slug: 'silver-needle', body: 'Naturally sweet and impossible to over-brew.' },
  { title: 'Best for Aging at Home', slug: 'shoumei', body: 'The affordable white tea that actually gets better with time.' },
];

function teaFor(slug: string): Tea | undefined {
  return getTea(slug);
}

const schemaJson = JSON.stringify([
  articleSchema({
    title,
    description,
    canonicalURL: 'https://www.chin-tea.com/best-teas',
    image: 'https://www.chin-tea.com/images/chinese-tea-og.webp',
    datePublished: '2026-08-01',
    dateModified: '2026-08-12',
  }),
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Best Chinese teas',
    itemListElement: [...topTen, ...bestByCategory, ...specialPicks]
      .map((x, i) => {
        const tea = teaFor(x.slug);
        return { '@type': 'Product', name: tea?.name ?? x.slug, url: tea ? `https://www.chin-tea.com/teas/${x.slug}` : undefined, position: i + 1 };
      }),
  },
]);
---

<BaseLayout {title} {description} schemaJson={schemaJson}>

  <section class="section-container pt-12 pb-4 reveal">
    <SectionHeader eyebrow="Rankings" title="The Best Chinese Teas" subtitle="If you only try ten teas in your life, start here. These are our picks — ranked by beginner-friendliness, fame, and value — with the best of each category below." headingLevel="h1" />
    <p class="mt-3 text-xs text-zinc-400 flex items-center gap-1.5"><span class="inline-block w-1.5 h-1.5 rounded-full bg-accent"></span> Last updated August 2026.</p>
  </section>

  <!-- Methodology note -->
  <section class="section-container py-4 reveal">
    <div class="card p-5 bg-paper-100 max-w-3xl">
      <h3 class="font-semibold text-warm-900 mb-1">How we ranked these</h3>
      <p class="text-xs text-muted leading-relaxed">These are honest editorial picks, not aggregated user votes — we don't publish rating scores we don't have. Each tea is ranked for its <strong class="text-warm-800">beginner-friendliness</strong> (how forgiving it is to brew), <strong class="text-warm-800">fame</strong> (how iconic it is within Chinese tea culture), and <strong class="text-warm-800">value</strong> (what you get for the price). The six-category winners are the best example of each type we cover.</p>
    </div>
  </section>

  <!-- Top ten -->
  <section class="section-container py-10">
    <SectionHeader eyebrow="The Ten to Try First" title="Top 10 Chinese Teas" headingLevel="h2" />
    <div class="mt-8 space-y-4">
      {topTen.map((t, i) => {
        const tea = teaFor(t.slug);
        if (!tea) return null;
        const type = getTeaType(tea.type);
        return (
          <a href={`/teas/${tea.slug}`} class="group card card-hover p-5 no-underline flex gap-5 items-center">
            <span class="flex-shrink-0 w-12 h-12 rounded-lg bg-leaf-600 text-white flex items-center justify-center font-accent text-xl font-semibold">{i + 1}</span>
            <div class="flex-1 min-w-0">
              <div class="flex flex-wrap items-center gap-2 mb-1">
                <h3 class="font-display font-semibold text-lg text-warm-900 group-hover:text-accent transition-colors">{tea.name}</h3>
                <span class={`px-2 py-0.5 text-xs rounded-full ${type?.accent.chip}`}>{type?.nameShort}</span>
              </div>
              <p class="text-sm text-muted leading-relaxed">{t.reason}</p>
            </div>
            <div class="flex-shrink-0 text-right hidden sm:block">
              <p class="text-xs text-zinc-400">{tea.origin.split(',')[0]}</p>
              <p class="text-xs font-medium text-accent mt-1">Full guide</p>
            </div>
            <ArrowRight class="w-4 h-4 text-leaf-400 flex-shrink-0 group-hover:translate-x-1 transition-transform" />
          </a>
        );
      })}
    </div>
  </section>

  <!-- Best by category -->
  <section class="bg-paper-100 py-16">
    <div class="section-container">
      <SectionHeader eyebrow="One Winner Per Type" title="Best Chinese Tea by Category" subtitle="The definitive example of each of the six types — the one to taste if you want to understand that category." headingLevel="h2" />
      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {bestByCategory.map((b) => {
          const tea = teaFor(b.slug);
          if (!tea) return null;
          const type = getTeaType(tea.type);
          return (
            <a href={`/teas/${tea.slug}`} class="group card card-hover p-5 no-underline flex flex-col">
              <div class="flex items-center gap-3 mb-3">
                <TeaVisual tea={tea} size="md" />
                <div>
                  <p class={`text-xs font-semibold ${type?.accent.text}`}>{b.label}</p>
                  <h3 class="font-display font-semibold text-lg leading-tight group-hover:text-accent transition-colors">{tea.name}</h3>
                </div>
              </div>
              <p class="text-xs text-muted mb-3">{tea.flavorShort}</p>
              <p class="text-xs text-zinc-400 mt-auto">{b.note}</p>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Special picks -->
  <section class="section-container py-16">
    <SectionHeader eyebrow="Situational Picks" title="Best Tea For…" headingLevel="h2" />
    <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {specialPicks.map((p) => {
        const tea = teaFor(p.slug);
        if (!tea) return null;
        return (
          <a href={`/teas/${tea.slug}`} class="group card card-hover p-5 no-underline flex flex-col">
            <h3 class="font-semibold text-warm-900 mb-1 group-hover:text-accent transition-colors">{p.title}</h3>
            <p class="text-sm text-muted leading-relaxed">{p.body}</p>
            <p class="text-xs font-medium text-accent mt-3">Try: {tea.name}</p>
          </a>
        );
      })}
    </div>
  </section>

  <CTACard primaryHref="/teas" primaryLabel="Browse All 21 Teas" secondaryHref="/flavours" secondaryLabel="Find by Flavour" />

  <RelatedLinks links={[
    { href: '/teas', label: 'best chinese green tea' },
    { href: '/teas/tie-guan-yin', label: 'best oolong for beginners' },
    { href: '/teas/silver-needle', label: 'best tea for beginners' },
    { href: '/guides/beginners', label: 'how to start drinking chinese tea' },
    { href: '/guides/buying', label: 'how much should chinese tea cost' },
    { href: '/flavours', label: 'find tea by flavour' },
  ]} />

</BaseLayout>
