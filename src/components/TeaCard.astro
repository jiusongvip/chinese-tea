---
import { existsSync } from 'node:fs';
import path from 'node:path';
import type { Tea } from '../data/teas';
import { getTeaType } from '../data/teaTypes';
import { ArrowRight } from '@lucide/astro';
import imageWidths from '../data/imageWidths.json';

interface Props {
  tea: Tea;
}

const { tea } = Astro.props;
const type = getTeaType(tea.type);
const badge = type?.accent.badge ?? 'bg-zinc-100 text-zinc-700';

// A unique per-tea photo dropped into public/images/teas/{slug}.webp,
// otherwise an ink-seal cover with the tea's own character.
const base = path.join(process.cwd(), 'public', 'images', 'teas');
const hasPhoto = existsSync(path.join(base, `${tea.slug}.webp`));
const dims = imageWidths[tea.slug as keyof typeof imageWidths];
const w = dims?.w ?? 640;
const h = dims?.h ?? 427;
const has400 = dims ? dims.w > 400 : false;
const webpSrcset = has400 ? `/images/teas/${tea.slug}.400.webp 400w, /images/teas/${tea.slug}.webp ${w}w` : undefined;
const avifSrcset = has400 ? `/images/teas/${tea.slug}.400.avif 400w, /images/teas/${tea.slug}.avif ${w}w` : undefined;
const sizes = "(min-width: 768px) 360px, 88vw";
---

<a href={`/teas/${tea.slug}/`} class="group card card-hover overflow-hidden flex flex-col no-underline">
  {hasPhoto ? (
    <div class="aspect-[3/2] overflow-hidden bg-paper-100 relative">
      <picture>
        {avifSrcset && <source type="image/avif" srcset={avifSrcset} sizes={sizes} />}
        <img src={`/images/teas/${tea.slug}.webp`} srcset={webpSrcset} sizes={sizes} alt={`${tea.name} (${tea.nameChinese})`} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" width={w} height={h} />
      </picture>
      <span class={`absolute top-2 left-2 text-[10px] font-bold px-2 py-0.5 rounded ${badge}`}>{type?.nameShort}</span>
    </div>
  ) : (
    <div class={`aspect-[3/2] relative overflow-hidden ${type?.accent.bg}`}>
      <div class="absolute inset-0 flex flex-col items-center justify-center gap-1 p-6 text-center">
        <span class="font-serif text-7xl leading-none select-none" aria-hidden="true">{tea.char}</span>
        <span class={`text-[10px] font-mono uppercase tracking-[0.25em] opacity-70 ${type?.accent.text}`}>{type?.nameShort} tea</span>
      </div>
      <span class={`absolute top-2 left-2 text-[10px] font-bold px-2 py-0.5 rounded ${badge}`}>{type?.nameShort}</span>
    </div>
  )}
  <div class="p-4 flex flex-col flex-1">
    <h3 class="font-display font-semibold text-lg leading-tight">{tea.name} <span class="text-sm font-normal text-zinc-500">{tea.nameChinese}</span></h3>
    <p class="text-xs text-muted mb-1">{tea.origin}</p>
    <p class="text-xs text-zinc-500 mt-auto mb-3 leading-relaxed">{tea.flavorShort}</p>
    <div class="flex items-center justify-between gap-2">
      <p class="text-xs font-medium text-accent underline underline-offset-2">Full guide + buying tips</p>
      <ArrowRight class="w-4 h-4 text-leaf-400 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200" />
    </div>
  </div>
</a>
