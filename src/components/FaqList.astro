---
import type { Faq } from '../data/faq';

interface Props {
  faqs: Faq[];
}

const { faqs } = Astro.props;
---

<div class="space-y-3">
  {faqs.map((item) => (
    <details class="group card overflow-hidden">
      <summary class="px-6 py-4 cursor-pointer font-medium text-warm-800 hover:text-accent transition-colors list-none flex items-center justify-between">
        {item.q}
        <svg class="w-5 h-5 text-zinc-500 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="px-6 pb-4 text-muted text-sm leading-relaxed">
        <p>{item.a}</p>
      </div>
    </details>
  ))}
</div>
