---
import type { TeaType } from '../data/teaTypes';
import { ArrowRight } from '@lucide/astro';

interface Props {
  type: TeaType;
}

const { type } = Astro.props;
const { accent } = type;
---

<a href={`/types/${type.slug}/`} class="group card card-hover overflow-hidden flex flex-col no-underline">
  <div class="aspect-[3/2] overflow-hidden bg-paper-100 relative">
    <img src={type.image} alt={`${type.name} (${type.nameZh})`} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" width="640" height="427" />
    <span class={`absolute top-2 left-2 text-[10px] font-bold px-2 py-0.5 rounded ${accent.badge}`}>{type.nameShort}</span>
  </div>
  <div class="p-4 flex flex-col flex-1">
    <h3 class="font-display font-semibold text-lg leading-tight">{type.name} <span class="text-sm font-normal text-zinc-500">{type.nameZh}</span></h3>
    <p class="text-xs text-muted mb-2">{type.oxidation}</p>
    <p class="text-xs text-zinc-500 leading-relaxed mb-3">{type.oneLiner}</p>
    <div class="mt-auto flex items-center justify-between gap-2">
      <p class={`text-xs font-medium ${accent.text}`}>{type.priceRange}</p>
      <ArrowRight class="w-4 h-4 text-leaf-400 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200" />
    </div>
  </div>
</a>
